# PocketBox Environment Variables

# Turso Cloud Database (Free SQLite Cloud: https://turso.tech)
# If omitted, PocketBox uses the local SQLite file in ./data/pocketbox.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Authentication (Optional for local dev, strongly recommended for Cloud/Vercel)
# If set, requires this password/PIN to access the web UI
POCKETBOX_PASSWORD=

# API Key for Firefox Extension & iOS Shortcut (optional, defaults to POCKETBOX_PASSWORD)
POCKETBOX_API_KEY=
